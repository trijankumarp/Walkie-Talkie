{
  "rules": {
    "publicChannels": {
      ".read": "auth != null",
      ".indexOn": ["wifiKey"],
      "$channelId": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid))"
      }
    },
    "userChannels": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "userSettings": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "publicUsers": {
      ".read": "auth != null",
      ".indexOn": ["displayNameLower", "emailLower"],
      "$handle": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))"
      }
    },
    "publicUsersByUid": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "publicUsersByEmail": {
      ".read": "auth != null",
      "$email": {
        ".write": "auth != null && newData.val() === auth.uid"
      }
    },
    "friendRequests": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        "$fromUid": {
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $toUid)"
        }
      }
    },
    "friendRequestSent": {
      "$fromUid": {
        ".read": "auth != null && auth.uid === $fromUid",
        "$toUid": {
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $toUid)"
        }
      }
    },
    "userFriends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)"
        }
      }
    },
    "friendChats": {
      "$uidA": {
        "$uidB": {
          ".read": "auth != null && (auth.uid === $uidA || auth.uid === $uidB)",
          "messages": {
            ".read": "auth != null && (auth.uid === $uidA || auth.uid === $uidB)",
            "$msgId": {
              ".write": "auth != null && (auth.uid === $uidA || auth.uid === $uidB) && newData.child('fromUid').val() === auth.uid",
              ".read": "auth != null && (auth.uid === $uidA || auth.uid === $uidB)"
            }
          }
        }
      }
    },
    "friendTalk": {
      "$uidA": {
        "$uidB": {
          ".read": "auth != null && (auth.uid === $uidA || auth.uid === $uidB)",
          ".write": "auth != null && (auth.uid === $uidA || auth.uid === $uidB)"
        }
      }
    },
    "friendIncomingCalls": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        "$fromUid": {
          ".read": "auth != null && (auth.uid === $fromUid || auth.uid === $toUid)",
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $toUid)"
        }
      }
    },
    "channelInvites": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        "$inviteId": {
          ".write": "auth != null && (auth.uid === $toUid || (!data.exists() && newData.child('fromUid').val() === auth.uid) || (data.exists() && data.child('fromUid').val() === auth.uid))"
        }
      }
    }
  }
}